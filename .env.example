# SPDX-License-Identifier: MIT
# Copy to `.env` and fill in. Required on first boot of docker compose up.

# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Set to "true" behind an HTTPS proxy (Caddy, Traefik, nginx) so cookies are Secure.
COOKIE_SECURE=false

# Set to "1" behind a reverse proxy so X-Forwarded-* headers are honored.
TRUST_PROXY=0

# "en" or "fr". Used to seed the starter deck on first boot.
SEED_LOCALE=en

# Set to "1" to reset the admin password to `changeme` at next boot.
# Remove the variable (or set to "0") and restart after use.
ADMIN_RESET=0

# Set to "1" to seed a shared demo account (username=demo, password=demo) on
# first boot. The account has the `user` role only; its bans and history are
# wiped on every sign-in so each visitor starts fresh. Off by default because
# it exposes a well-known credential — only enable on public demo instances.
ENABLE_DEMO_ACCOUNT=0

# Set to "1" to open public self-registration on the very first boot. After that,
# the "Public registration" switch in the admin Users tab is the source of truth
# and this variable is ignored. Off by default.
ENABLE_REGISTRATION=0
